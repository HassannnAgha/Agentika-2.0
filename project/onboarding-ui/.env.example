# Copy to .env.local (never committed) and fill in.

# Google AI Studio key, used server-side only to extract onboarding data from
# the business website, documents, resumes and client spreadsheets.
GEMINI_API_KEY=

# Optional. Leave blank to use gemini-flash-latest, Google's alias for the
# current Flash model.
GEMINI_MODEL=

# Fallback when Gemini is overloaded, over quota or down (text sources only, not PDFs). Optional second key for rotation.
GROQ_API_KEY=
GROQ_API_KEY_2=
