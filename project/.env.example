# Copy to .env for local runs. On Alternate Clouds put these in the Variables tab instead. NEVER commit .env.
# Everything is optional: with none set the app runs on local files, templates and canned data.

# Postgres (Neon). Persists the business profile, leads, facts, outbox and audit trail across redeploys.
DATABASE_URL=

# AI drafting for lead outreach and client emails (Groq, free key at console.groq.com/keys). Falls back to templates.
GROQ_API_KEY=
GROQ_API_KEY_2=       # optional second key, tried when the first is rate limited
GROQ_MODEL=openai/gpt-oss-120b

# Onboarding import from website/documents (Gemini). Set in onboarding-ui/.env.local for local dev.
GEMINI_API_KEY=

# Email never goes to a real prospect. With these set, approved emails are delivered to TEST_INBOX only.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
TEST_INBOX=

# Demo knobs
AUDIT_RATE=0
DEMO_FAIL_RATE=0

# Mailbox the Operations agent reads (IMAP). Gmail: imap.gmail.com + an app password. Use a dedicated test mailbox, never a personal one.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
INBOX_POLL=1

# Jira Cloud as the real task tool (optional). Without these, tasks live in the simulated store only.
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# Most messages one campaign may contain
CAMPAIGN_DAILY_CAP=25

# --- REAL SENDING (off by default). With SEND_LIVE=1 approved emails go to the REAL recipient.
# Every marketing message gets your business name and postal address plus a signed unsubscribe link and a one-click header.
# Without BUSINESS_ADDRESS, marketing mail is refused. LIVE_DAILY_CAP limits how many can go in a day. Opt-outs are honoured everywhere.
SEND_LIVE=0
# (name and postal address are read from onboarding; these are only a fallback)
BUSINESS_NAME=
BUSINESS_ADDRESS=
PUBLIC_URL=            # the deployed URL, so unsubscribe links work (https://your-service-app.alternatefutures.ai)
UNSUB_SECRET=          # any long random string; keep the same for the life of the service
LIVE_DAILY_CAP=30

# --- LOGIN for the deployed URL (judges get this demo account in the submission PDF; never a personal password).
# Unset = open (local dev only). With SEND_LIVE=1 and no APP_PASSWORD the whole app refuses to serve. /u/* and /health stay open.
APP_USER=judge
APP_PASSWORD=
IMAP_SINCE=           # only mail received on/after this date (YYYY-MM-DD); default today
IMAP_FOLDER=INBOX    # or a Gmail label such as bizzii
